---
import Base from '../../layouts/Base.astro';
import ListaPasos from '../../components/ListaPasos.svelte';
import { getCollection } from 'astro:content';
import { RUTAS } from '../../data/rutas';

export async function getStaticPaths() {
  return RUTAS.map((ruta) => ({ params: { slug: ruta.slug }, props: { ruta } }));
}

const { ruta } = Astro.props;

// Las rutas con guías propias generan sus pasos desde la colección.
const guias = (await getCollection('guias', (g) => g.data.ruta === ruta.slug)).sort(
  (a, b) => a.data.orden - b.data.orden
);

// Cada paso lleva una `key` estable para el progreso: id de guía o href del paso.
// Un paso que reutiliza una guía de otra ruta guarda su progreso en la ruta de la guía
// (`progreso`), así marcarlo aquí o en la propia guía es lo mismo.
const todasGuias = await getCollection('guias');
const desdeGuia = (g: (typeof todasGuias)[number]) => ({
  tipo: 'guia' as const,
  titulo: g.data.title,
  href: `/rutas/${g.data.ruta}/${g.id}`,
  meta: g.data.duracion,
  key: g.id,
  progreso: g.data.ruta,
});
const pasos =
  guias.length > 0
    ? guias.map((g) => ({
        ...desdeGuia(g),
        // El número del paso es el de la guía (orden): así un tráiler va como 00 y los huecos de una ruta se ven.
        numero: g.data.orden,
      }))
    : ruta.pasos.map((p) => {
        if (!('guia' in p)) return { ...p, key: p.href };
        const g = todasGuias.find((x) => x.id === p.guia);
        if (!g) throw new Error(`La ruta ${ruta.slug} cita la guía ${p.guia}, que no existe`);
        return desdeGuia(g);
      });

const tieneContrato =
  ruta.aprenderas?.length || ruta.requisitos?.length || ruta.noIncluye?.length;
---

<Base title={ruta.titulo} description={ruta.descripcion} activeHref="/rutas">
  <div class="container">
    <section class="section">
      <p class="eyebrow">guía · {ruta.nivel} · {ruta.duracion}</p>
      <h1>{ruta.titulo}</h1>
      <p class="lead" style="max-width: 42rem;">{ruta.descripcion}</p>
      {ruta.paraQuien && <p class="meta" style="max-width: 42rem;">Para ti si: {ruta.paraQuien}</p>}
      {
        ruta.oculta && (
          <p class="aviso-ruta">
            Esta guía está en revisión y ya no aparece en el listado. Si buscas por dónde empezar, ve a{' '}
            <a href="/rutas/ia-desde-cero">IA desde cero</a>.
          </p>
        )
      }

      {
        ruta.porQue && (
          <div class="ruta-bloque">
            <h2>{ruta.porQue.titulo}</h2>
            <p class="lead" style="max-width: 42rem;">{ruta.porQue.intro}</p>
            <div class="grid-3" style="margin-top: 1.5rem;">
              {ruta.porQue.puntos.map((p) => (
                <div class="card">
                  <h3>{p.titulo}</h3>
                  <p>{p.texto}</p>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {
        ruta.equivalencias?.length && (
          <div class="ruta-bloque">
            <h2>Lo que aprendes aquí, en otros agentes</h2>
            <div class="tabla-scroll">
              <table class="tabla-equiv">
                <thead>
                  <tr>
                    <th scope="col">Concepto</th>
                    <th scope="col">En Pi y oh my pi</th>
                    <th scope="col">En otros agentes</th>
                  </tr>
                </thead>
                <tbody>
                  {ruta.equivalencias.map((e) => (
                    <tr>
                      <th scope="row">{e.concepto}</th>
                      <td>{e.aqui}</td>
                      <td>{e.otros}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {ruta.equivalenciasNota && <p class="meta" style="margin-top: 0.75rem;">{ruta.equivalenciasNota}</p>}
          </div>
        )
      }

      {
        ruta.etapas?.length && (
          <div class="ruta-bloque">
            <h2>De lo mínimo a tu propio harness</h2>
            <ol class="etapas">
              {ruta.etapas.map((e, i) => (
                <li class="etapa">
                  <span class="etapa__n" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{e.titulo}</h3>
                    <p class="meta">{e.videos}</p>
                    <p>{e.descripcion}</p>
                    {e.profundizar && (
                      <div class="profundizar">
                        <p class="profundizar__t">Para profundizar</p>
                        <ul>
                          {e.profundizar.map((l) => (
                            <li>
                              <span class="badge">{l.tipo}</span> <a href={l.href}>{l.titulo}</a>
                              {l.meta && <span class="meta"> · {l.meta}</span>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      {
        tieneContrato && (
          <div class="grid-3" style="margin-top: 2.5rem;">
            {ruta.aprenderas?.length && (
              <div class="card">
                <h3>Qué te llevas</h3>
                <ul class="lista-check">
                  {ruta.aprenderas.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
            {ruta.requisitos?.length && (
              <div class="card">
                <h3>Requisitos</h3>
                <ul class="lista-check lista-check--neutro">
                  {ruta.requisitos.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
            {ruta.noIncluye?.length && (
              <div class="card">
                <h3>Qué NO cubre</h3>
                <ul class="lista-check lista-check--no">
                  {ruta.noIncluye.map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )
      }

      <h2 style="margin-top: 3rem;">El recorrido</h2>
      <ListaPasos client:load ruta={ruta.slug} pasos={pasos} />

      <p style="margin-top: 2rem;">
        <a href="/rutas">← Todas las rutas</a>
      </p>
    </section>
  </div>
</Base>
